# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Public URL for webhook (Railway domain)
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Webhook secret token
WEBHOOK_SECRET=your_webhook_secret_here

# Allowlist of user IDs and usernames (comma separated)
ALLOWLIST=123456789,@username

# Optional settings
USE_WEBHOOK=true
PORT=8080
READ_TIMEOUT_SEC=120
GROQ_MODEL_PRIMARY=whisper-large-v3-turbo
GROQ_MODEL_FALLBACK=whisper-large-v3

# OpenAI API Key for summary generation and TTS (optional but required for TTS)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI TTS settings
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_RESPONSE_FORMAT=opus
OPENAI_TTS_MAX_CHARS=4096
OPENAI_TTS_RATE_LIMIT_PER_MINUTE=5
OPENAI_TTS_WINDOW_SEC=60
